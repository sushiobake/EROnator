// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // 接続プーリング用（Vercel serverless用）
  directUrl = env("DIRECT_URL")        // 直接接続用（マイグレーション用、オプション）
}

// Works: 作品データ
model Work {
  id                  String   @id @default(cuid())
  workId              String   @unique // 内部ID（stable）
  title               String
  authorName          String
  isAi                String   // "AI" | "HAND" | "UNKNOWN"
  popularityBase      Float    @default(0) // 0..55 target
  popularityPlayBonus Float    @default(0)
  reviewCount         Int?
  reviewAverage       Float?
  productUrl          String   // 必須（外部リンク）
  affiliateUrl        String?
  thumbnailUrl        String?  // オプション（公式サムネURL）
  sourcePayload       String?  @default("{}") // JSON string (optional)
  contentId           String?
  releaseDate         String?
  pageCount           String?
  seriesInfo          String?  // JSON string
  commentText         String?  // 作品コメント（取得済み時）
  gameRegistered      Boolean? // ゲームに登録済み
  needsReview         Boolean? // 要注意
  tagSource           String?  // "human" | "ai" | "untagged" 等
  aiAnalyzed          Boolean?
  humanChecked        Boolean?
  aiChecked           Boolean?
  needsHumanCheck     Boolean?
  checkQueueAt        DateTime?
  manualTaggingFolder String?
  taggedAt            DateTime? // タグ済みフォルダに入れた日時（一覧の整列・整合用）
  lastCheckTagChanges String?  // AIチェック時の追加推奨・削除推奨 JSON: { added: string[], removed: string[] }
  lastCheckResultJson String?  // 最終チェックの完全な出力 JSON
  lastCheckReasoning  String?  // AIチェック時の推論 JSON
  lastTaggingReasoning String?  // AIタグ付け時の推論 JSON
  titleReadingInitial String?  // タイトル読みの先頭1文字（カタカナ）。50音質問用
  titleReadingInitialConfirmed Boolean?  // 頭文字確認済み（管理画面用。確認済みは一覧から非表示）
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  workTags WorkTag[]

  @@index([workId])
  @@index([isAi])
}

// Tags: タグデータ
model Tag {
  id                String   @id @default(cuid())
  tagKey            String   @unique // stable key
  displayName       String
  tagType           String   // "OFFICIAL" | "DERIVED" | "STRUCTURAL"
  category          String?  // nullable
  questionText      String?  // タグごとの質問文（nullable）
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  workTags WorkTag[]

  @@index([tagKey])
  @@index([tagType])
}

// WorkTags: 作品-タグの多対多関係
model WorkTag {
  id                String   @id @default(cuid())
  workId            String
  tagKey            String
  derivedSource     String?  // "additionalS" | "manual" | "chatgpt-matched" 等
  derivedConfidence Float?   // nullable (DERIVEDタグのみ)
  createdAt         DateTime @default(now())

  // Relations
  work Work @relation(fields: [workId], references: [workId], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagKey], references: [tagKey], onDelete: Cascade)

  @@unique([workId, tagKey])
  @@index([workId])
  @@index([tagKey])
}

// Sessions: ゲームセッション状態
model Session {
  id                      String   @id @default(cuid())
  sessionId               String   @unique
  version                 Int      @default(0) // 楽観的ロック用
  aiGateChoice            String?  // "YES" | "NO" | "DONT_CARE" | null
  questionCount           Int      @default(0)
  revealMissCount         Int      @default(0)
  revealRejectedWorkIds    String   @default("[]") // JSON array string
  weights                 String   @default("{}") // JSON object: { workId: weight }
  weightsHistory          String   @default("[]") // 互換用。実体は SessionWeightsSnapshot に格納
  questionHistory         String   @default("[]") // JSON array
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  weightsSnapshots        SessionWeightsSnapshot[]

  @@index([sessionId])
}

// 修正機能用: 重みスナップショットを別テーブルで保持（セッション本体の肥大化を防止）
model SessionWeightsSnapshot {
  id         String   @id @default(cuid())
  sessionId  String
  qIndex     Int      // 質問番号（回答前の状態）
  weightsJson String  // JSON: weightsToStored 形式

  session    Session  @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@unique([sessionId, qIndex])
  @@index([sessionId])
}

// Logs: FAIL_LISTの自由入力保存
model Log {
  id                String   @id @default(cuid())
  submittedTitleText String
  aiGateChoice      String?  // "YES" | "NO" | "DONT_CARE"
  topCandidates     String?  @default("[]") // JSON array (optional snapshot)
  timestamp         DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([timestamp])
}

// PlayHistory: 1プレイ＝1レコード（質問列・回答列・結果・時刻）
model PlayHistory {
  id                  String    @id @default(cuid())
  sessionId           String    @unique // 1セッション＝1レコード
  outcome             String    // "SUCCESS" | "FAIL_LIST" | "ALMOST_SUCCESS" | "NOT_IN_LIST"
  questionCount       Int       @default(0)
  questionHistory     String    @default("[]") // JSON: 質問列（displayText, kind, answer 等）
  aiGateChoice        String?   // "YES" | "NO" | "DONT_CARE"
  resultWorkId        String?   // 正解 or 候補から選択した workId
  submittedTitleText  String?   // リスト外入力（NOT_IN_LIST 時）
  sessionStartedAt   DateTime? // セッション開始時刻（総合滞在時間算出用）
  clickedFanza        Boolean   @default(false) // FANZAで見るリンクをクリックしたか
  createdAt           DateTime  @default(now())

  @@index([sessionId])
  @@index([outcome])
  @@index([createdAt])
}

// お問い合わせフォーム（管理画面で一覧表示。将来メール転送用）
model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String?
  subject   String?  // 不具合の報告 | 同人誌の登録要望 | その他 など
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
